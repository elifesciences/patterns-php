<ul class="institution-search-results__list" hx-boost="true" hx-target="#institution-eligibility-checker-outcome" hx-swap="innerHTML">
   {{#institutions}}
     <li class="institution-search-results__item">
       <a class="institution-search-results__link" href="{{{url}}}">{{{name}}}</a>
     </li>
   {{/institutions}}
 </ul>
 {{^institutions}}
   {{#emptyMessage}}<p class="institution-search-results__empty">{{{emptyMessage}}}</p>{{/emptyMessage}}
 {{/institutions}}