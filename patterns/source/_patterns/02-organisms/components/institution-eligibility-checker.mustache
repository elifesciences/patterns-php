<div class="institution-eligibility-checker">
    <form class="institution-eligibility-checker__form" id="{{formId}}" action="{{searchUrl}}" method="GET" novalidate>
        <label class="institution-eligibility-checker__label" for="{{formId}}-input">{{label}}</label>
        <input
                type="search" id="{{formId}}-input" name="{{inputName}}" value="{{inputValue}}"
                placeholder="{{inputPlaceholder}}" class="institution-eligibility-checker__input" autocomplete="off"
                aria-controls="institution-eligibility-checker-results"
                hx-get="{{searchUrl}}" hx-trigger="keyup changed delay:300ms, search"
                hx-target="#institution-eligibility-checker-results" hx-indicator="#{{formId}}-indicator">
        <button type="submit" class="institution-eligibility-checker__submit">{{ctaText}}</button>
    </form>
    <div id="institution-eligibility-checker-results" class="institution-eligibility-checker__results" aria-live="polite"></div>
    <div id="institution-eligibility-checker-outcome" class="institution-eligibility-checker__outcome" aria-live="polite"></div>
</div>